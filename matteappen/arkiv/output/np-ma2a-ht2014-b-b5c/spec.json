  "writeLines": [
    {
      "text": "3^x + 3^x + 3^x är inte 3^{3x}"
    },
    {
      "text": "Tre lika termer: 3 · 3^x"
    },
    {
      "text": "3 · 3 · 3^x = 3^2 · 3^x = 3^{2 + x}"
    },
    {
      "text": "3^{2 + x} = 3^{35}"
    },
    {
      "text": "2 + x = 35"
    },
    {
      "text": "x = 35 − 2 = 33"
    },
    {
      "text": "x = 33",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Träna alla gamla NP i Integro",
      "cta": true
    }
