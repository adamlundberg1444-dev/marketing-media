  "writeLines": [
    {
      "text": "Dela inte med (x - 4)"
    },
    {
      "text": "Sätt t = x - 4"
    },
    {
      "text": "t^2 = 2t"
    },
    {
      "text": "t^2 − 2t = 0"
    },
    {
      "text": "t(t − 2) = 0"
    },
    {
      "text": "t = 0 ger x = 4"
    },
    {
      "text": "t = 2 ger x = 6"
    },
    {
      "text": "x_1 = 4, x_2 = 6",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Hela provet finns i Integro-appen",
