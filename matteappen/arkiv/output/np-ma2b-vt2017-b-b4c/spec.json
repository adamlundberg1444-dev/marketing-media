  "writeLines": [
    {
      "text": "3^{2x} = (3^x)^2"
    },
    {
      "text": "Sätt t = 3^x"
    },
    {
      "text": "t^2 = 2t"
    },
    {
      "text": "t^2 − 2t = 0"
    },
    {
      "text": "t(t − 2) = 0"
    },
    {
      "text": "t = 0 eller t = 2"
    },
    {
      "text": "3^x = 2 (t = 0 omöjligt)"
    },
    {
      "text": "x · lg 3 = lg 2"
    },
    {
      "text": "x = \\frac{lg 2}{lg 3}",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Fler gamla NP i appen Integro",
      "cta": true
    }
