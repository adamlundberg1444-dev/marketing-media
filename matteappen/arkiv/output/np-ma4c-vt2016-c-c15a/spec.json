  "writeLines": [
    {
      "text": "sin v = \\frac{4}{5}",
      "pauseAfter": 0.4
    },
    {
      "text": "sin^2 v + cos^2 v = 1",
      "pauseAfter": 0.4
    },
    {
      "text": "sin^2 v = (\\frac{4}{5})^2 = \\frac{16}{25}",
      "pauseAfter": 0.4
    },
    {
      "text": "cos^2 v = 1 − \\frac{16}{25} = \\frac{9}{25}",
      "pauseAfter": 0.4
    },
    {
      "text": "cos v = \\frac{3}{5}",
      "pauseAfter": 0.5
    },
    {
      "text": "cos(v + 45°) ="
    },
    {
      "text": "cos v cos 45° − sin v sin 45°",
      "pauseAfter": 0.5
    },
    {
      "text": "cos 45° = sin 45° = \\frac{1}{2}\\sqrt{2}",
      "pauseAfter": 0.5
    },
    {
      "text": "= (\\frac{3}{5} − \\frac{4}{5}) \\cdot \\frac{1}{2}\\sqrt{2}",
      "pauseAfter": 0.4
    },
    {
      "text": "= −\\frac{1}{5} \\cdot \\frac{1}{2}\\sqrt{2}",
      "pauseAfter": 0.4
    },
    {
      "text": "= −\\frac{1}{10}\\sqrt{2}",
      "emphasis": true
    },
    {
      "text": "−\\frac{1}{10}\\sqrt{2}",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
