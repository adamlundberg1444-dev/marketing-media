    {
      "text": "(x + 8)^6 = (x + 8)^5 · (x + 8)",
      "pauseAfter": 0.5
    },
    {
      "text": "(x+8)^5(x + 8) − (x+8)^5"
    },
    {
      "text": "= (x+8)^5(x + 8 − 1)"
    },
    {
      "text": "= (x+8)^5(x + 7)",
      "pauseAfter": 0.5
    },
    {
      "text": "\\frac{(x+8)^5(x + 7)}{(x+8)^5}",
      "pauseAfter": 0.5
    },
    {
      "text": "= x + 7",
      "pauseAfter": 0.5
    },
    {
      "text": "x + 7 = 2,7 + 7 = 9,7",
      "emphasis": true
    },
    {
      "text": "9,7",
      "answer": true,
