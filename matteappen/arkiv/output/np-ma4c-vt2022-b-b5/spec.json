    {
      "text": "sin^2 x + cos^2 x = 1 (trig ettan)",
      "pauseAfter": 0.5
    },
    {
      "text": "Integranden: 1 + sin x"
    },
    {
      "text": "Primitiv: x − cos x",
      "pauseAfter": 0.5
    },
    {
      "text": "Övre: pi/2 − cos(pi/2) = pi/2"
    },
    {
      "text": "Nedre: 0 − cos 0 = −1",
      "pauseAfter": 0.5
    },
    {
      "text": "pi/2 − (−1) = 1 + pi/2",
      "emphasis": true
    },
    {
      "text": "1 + pi/2",
      "answer": true,
      "pauseAfter": 0.6
    },
