  "writeLines": [
    {
      "text": "Prova n = -2"
    },
    {
      "text": "n - 2 = -2 - 2 = -4"
    },
    {
      "text": "2n = 2 · (-2) = -4"
    },
    {
      "text": "n/2 = -2/2 = -1"
    },
    {
      "text": "2/n = 2/(-2) = -1"
    },
    {
      "text": "n^2 = (-2)^2 = 4"
    },
    {
      "text": "Bara n^2 blir positivt"
    },
    {
      "text": "Hela provet finns i Integro-appen",
      "cta": true
    }
