  "writeLines": [
    {
      "text": "Lilla radien r, stora radien R"
    },
    {
      "text": "Kateter r, r och hypotenusa R",
      "pauseAfter": 0.5
    },
    {
      "text": "Pythagoras: R^2 = r^2 + r^2 = 2r^2",
      "pauseAfter": 0.5
    },
    {
      "text": "Lilla arean: pi · r^2"
    },
    {
      "text": "Stora arean: pi · R^2 = pi · 2r^2"
    },
    {
      "text": "= dubbelt så stor!",
      "emphasis": true
    },
    {
      "text": "A stor = 2 · A liten",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Hela provet finns i Integro-appen",
      "cta": true
    }
