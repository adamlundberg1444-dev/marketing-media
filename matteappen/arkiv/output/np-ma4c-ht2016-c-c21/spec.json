    {
      "text": "Kvotregeln ger täljare:"
    },
    {
      "text": "−sin^2 x − sin x − cos^2 x"
    },
    {
      "text": "= −1 − sin x = −(sin x+1)"
    },
    {
      "text": "f' = −(sin x+1)/(sin x+1)^2"
    },
    {
      "text": "= −1/(sin x+1)"
    },
    {
      "text": "sin x+1 > 0, så f' < 0: avtar",
      "emphasis": true
    },
    {
      "text": "f'=−1/(sin x+1) < 0",
      "answer": true,
