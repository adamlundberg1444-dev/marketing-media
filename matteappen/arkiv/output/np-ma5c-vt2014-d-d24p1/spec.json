  "writeLines": [
    {
      "text": "Två grupper med 5 personer",
      "pauseAfter": 0.5
    },
    {
      "text": "Välj 5 av de 10:"
    },
    {
      "text": "\\binom{10}{5} = \\frac{10!}{5!(10-5)!}"
    },
    {
      "text": "= \\frac{10!}{5! · 5!}"
    },
    {
      "text": "= \\frac{3628800}{14400} = 252"
    },
    {
      "text": "Varje indelning räknas 2 ggr",
      "pauseAfter": 0.5
    },
    {
      "text": "252/2 = 126",
      "emphasis": true
    },
    {
      "text": "126 sätt",
      "answer": true,
