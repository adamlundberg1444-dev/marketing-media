      {
        "text": "Beräkna"
      },
      {
        "tex": "\\dfrac{4{,}88^2 + (1{,}12 - 4{,}88)^2 - (4{,}88 + 1{,}12)^2}{4{,}88}",
        "display": false
      },
      {
        "text": "."
      }
    ],
    "options": null,
    "svarPrefix": "Svar:",
    "correctOption": null,
    "image": null,
    "imageMax": null
  },
  "writeLines": [
    {
      "text": "Sätt a = 4,88 och b = 1,12"
    },
    {
      "text": "(a^2 + (b − a)^2 − (a + b)^2)/a",
      "pauseAfter": 0.5
    },
    {
      "text": "(b − a)^2 = b^2 − 2ab + a^2"
    },
    {
      "text": "(a + b)^2 = a^2 + 2ab + b^2",
      "pauseAfter": 0.5
    },
    {
      "text": "Täljaren: a^2 − 4ab = a(a − 4b)",
      "pauseAfter": 0.5
    },
    {
      "text": "= a − 4b = 4,88 − 4,48 = 0,4",
      "emphasis": true
    },
    {
      "text": "0,4",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Fler gamla NP i appen Integro",
      "cta": true
    }
