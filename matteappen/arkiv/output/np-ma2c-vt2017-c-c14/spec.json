  "writeLines": [
    {
      "text": "CB = 24 + 12 = 36",
      "pauseAfter": 0.5
    },
    {
      "text": "\\frac{CE}{CB} = \\frac{DE}{AB}",
      "pauseAfter": 0.4
    },
    {
      "text": "\\frac{24}{36} = \\frac{12 · 2}{12 · 3} = \\frac{2}{3}",
      "pauseAfter": 0.4
    },
    {
      "text": "\\frac{2}{3} = \\frac{16}{AB}",
      "pauseAfter": 0.4
    },
    {
      "text": "2 \\cdot AB = 3 \\cdot 16 = 48",
      "pauseAfter": 0.3
    },
    {
      "text": "AB = 24",
      "pauseAfter": 0.3
    },
    {
      "text": "AB = \\frac{8}{5}x",
      "pauseAfter": 0.3
    },
    {
      "text": "\\frac{8}{5}x = 24",
      "pauseAfter": 0.3
    },
    {
      "text": "8x = 5 · 24 = 120",
      "pauseAfter": 0.3
    },
    {
      "text": "x = \\frac{120}{8} = 15",
      "emphasis": true
    },
    {
      "text": "AD = 15 cm",
      "answer": true,
      "pauseAfter": 0.6
    },
