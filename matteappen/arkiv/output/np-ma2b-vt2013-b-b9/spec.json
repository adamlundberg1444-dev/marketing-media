  "writeLines": [
    {
      "text": "Gränser: x^2 = 3"
    },
    {
      "text": "x = \\sqrt{3} och x = -\\sqrt{3}"
    },
    {
      "text": "Tre områden på tallinjen"
    },
    {
      "text": "x = 0 ger 0^2 = 0, 0 > 3 falskt"
    },
    {
      "text": "x = 2 ger 2^2 = 4, 4 > 3 sant"
    },
    {
      "text": "x < -\\sqrt{3} eller x > \\sqrt{3}",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Hela provet finns i Integro-appen",
