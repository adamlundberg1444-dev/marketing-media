      "text": "1 + x + x^2 + ... + x^6",
      "pauseAfter": 0.4
    },
    {
      "text": "(x − 1)(1 + x + x^2 + ... + x^6)"
    },
    {
      "text": "= x + x^2 + ... + x^6 + x^7"
    },
    {
      "text": "− 1 − x − x^2 − ... − x^6",
      "pauseAfter": 0.3
    },
    {
      "text": "= x^7 − 1",
      "pauseAfter": 0.5
    },
    {
      "text": "x^7 − 1 = 2(x − 1)(x^7 − 1)",
      "pauseAfter": 0.4
    },
    {
      "text": "1 = 2(x − 1)",
      "pauseAfter": 0.3
    },
    {
      "text": "1 = 2x − 2"
    },
    {
      "text": "2x = 1 + 2 = 3",
      "pauseAfter": 0.3
    },
    {
      "text": "x = \\frac{3}{2} = 1,5",
      "emphasis": true
    },
