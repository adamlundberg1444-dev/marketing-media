  "writeLines": [
    {
      "text": "\\frac{20}{3 + i}",
      "pauseAfter": 0.4
    },
    {
      "text": "= \\frac{20(3 − i)}{(3 + i)(3 − i)}",
      "pauseAfter": 0.5
    },
    {
      "text": "(3 + i)(3 − i) = 9 − 3i + 3i − i^2"
    },
    {
      "text": "= 9 − i^2"
    },
    {
      "text": "i^2 = −1"
    },
    {
      "text": "9 − (−1) = 10",
      "pauseAfter": 0.5
    },
    {
      "text": "20(3 − i) = 60 − 20i",
      "pauseAfter": 0.5
    },
    {
      "text": "= \\frac{60 − 20i}{10}",
      "pauseAfter": 0.4
    },
    {
      "text": "= 6 − 2i",
      "emphasis": true
    },
    {
      "text": "6 − 2i",
      "answer": true,
      "pauseAfter": 0.6
    },
