      "text": "(2x + 3)^5",
      "pauseAfter": 0.4
    },
    {
      "text": "\\binom{5}{k} (2x)^{5 − k} \\cdot 3^k",
      "pauseAfter": 0.4
    },
    {
      "text": "5 − k = 3"
    },
    {
      "text": "k = 2",
      "pauseAfter": 0.4
    },
    {
      "text": "\\binom{5}{2} (2x)^3 \\cdot 3^2",
      "pauseAfter": 0.5
    },
    {
      "text": "\\binom{5}{2} = \\frac{5!}{2! \\cdot 3!}"
    },
    {
      "text": "= \\frac{120}{2 \\cdot 6} = \\frac{120}{12} = 10",
      "pauseAfter": 0.4
    },
    {
      "text": "(2x)^3 = 8x^3"
    },
    {
      "text": "3^2 = 9",
      "pauseAfter": 0.4
    },
    {
      "text": "10 \\cdot 8 \\cdot 9 = 80 \\cdot 9 = 720"
    },
    {
      "text": "720x^3",
      "emphasis": true
    },
    {
      "text": "720",
      "answer": true,
      "pauseAfter": 0.6
    },
    {
      "text": "Fler gamla NP i appen Integro",
      "cta": true
    }
