    },
    {
      "text": "F(3) − F(0) = 27 − 9 − 0 = 18 − 0 = 18",
      "pauseAfter": 0.5
    },
    {
      "text": "G(x) = sin x",
      "pauseAfter": 0.4
    },
    {
      "text": "G(\\frac{\\pi}{2}) − G(0) = 1 − 0 = 1",
      "pauseAfter": 0.5
    },
    {
      "text": "A = 18 − 1 = 17",
