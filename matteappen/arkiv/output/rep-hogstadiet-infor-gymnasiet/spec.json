  "eyebrow": "Repetition inför gymnasiet",
  "writeLines": [
    {
      "text": "Inför gymnasiet",
      "title": true
    },
    {
      "text": "Det viktigaste från högstadiet",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Räkneordningen",
      "title": true
    },
    {
      "text": "1. Parenteser",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "2. Potenser",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "3. Gånger och delat",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "4. Plus och minus",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Negativa tal",
      "title": true
    },
    {
      "text": "5 − (−3) = 5 + 3 = 8",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "minus · minus = plus",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "(−4) · (−2) = +8",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Bråk",
      "title": true
    },
    {
      "text": "Plus kräver samma nämnare:",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "1/2 + 1/3 = 3/6 + 2/6 = 5/6",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Gånger räknas rakt över:",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "2/3 · 4/5 = 8/15",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Procent",
      "title": true
    },
    {
      "text": "Höjning 25%: gånger 1,25",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Rea 30%: gånger 0,70",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "= förändringsfaktorn",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Ekvationer",
      "title": true
    },
    {
      "text": "3x + 4 = 19",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "3x = 15",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "x = 5",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Gör samma sak i båda leden!",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Pythagoras sats",
      "title": true
    },
    {
      "text": "a^2 + b^2 = c^2",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Gäller rätvinkliga trianglar",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "c är längsta sidan",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Räta linjen",
      "title": true
    },
    {
      "text": "y = kx + m",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "k = lutningen",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "m = skär y-axeln",
      "cta": false,
      "emphasis": false
    },
    {
      "text": "Lycka till!",
      "title": true
    },
    {
      "text": "Fler genomgångar i appen Integro",
      "cta": true,
      "emphasis": false
    }
