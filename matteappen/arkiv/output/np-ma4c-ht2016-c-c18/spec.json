  "writeLines": [
    {
      "text": "Belopp: roten ur (3+1) = 2"
    },
    {
      "text": "Argument: tan v = 1/roten ur 3"
    },
    {
      "text": "ger v = 30°"
    },
    {
      "text": "de Moivre: 2^6, vinkel 6·30°=180°"
    },
    {
      "text": "= 64(cos 180° + i·sin 180°)"
    },
    {
      "text": "= 64·(−1) = −64",
      "emphasis": true
    },
    {
      "text": "−64",
