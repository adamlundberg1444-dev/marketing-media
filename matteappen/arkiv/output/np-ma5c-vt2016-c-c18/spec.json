    {
      "text": "n=1: VL=1·1!=1, HL=2!−1=1"
    },
    {
      "text": "Antag: summan = (p+1)! − 1",
      "pauseAfter": 0.5
    },
    {
      "text": "n=p+1: lägg till (p+1)(p+1)!"
    },
    {
      "text": "= (p+1)!−1+(p+1)(p+1)!"
    },
    {
      "text": "= (p+1)!(p+2) − 1 = (p+2)!−1"
    },
    {
      "text": "Ärvs, gäller för alla n",
      "emphasis": true
    },
