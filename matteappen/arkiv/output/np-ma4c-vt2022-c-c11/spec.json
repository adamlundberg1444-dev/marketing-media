    },
    {
      "text": "Täljare: 8 − 16i + 6i − 12i^2"
    },
    {
      "text": "= 8 + 12 − 10i = 20 − 10i",
      "pauseAfter": 0.5
    },
    {
      "text": "(20 − 10i)/5 = 4 − 2i",
      "emphasis": true
    },
    {
      "text": "4 − 2i",
