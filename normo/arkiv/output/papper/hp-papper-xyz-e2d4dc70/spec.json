  "captions": [
    {
      "text": "Tre bråk",
      "start": 4.88,
      "end": 6.23
    },
    {
      "text": "och alla har var sin nämnare",
      "start": 6.23,
      "end": 8.77
    },
    {
      "text": "Okej, tillbaka till papperet",
      "start": 8.77,
      "end": 10.45
    },
    {
      "text": "Vi ska lägga ihop dem",
      "start": 10.45,
      "end": 11.9
    },
    {
      "text": "Lätt. 1 plus 3 plus",
      "start": 11.9,
      "end": 14.791
    },
    {
      "text": "9 är 13",
      "start": 14.791,
      "end": 16.121
    },
    {
      "text": "Det blir 13 femtiondelar",
      "start": 16.121,
      "end": 18.681
    },
    {
      "text": "svaret är B",
      "start": 18.681,
      "end": 20.151
    },
    {
      "text": "Men vänta lite nu",
      "start": 20.151,
      "end": 21.491
    },
    {
      "text": "Nej, femtedelar och femtiondelar är",
      "start": 21.491,
      "end": 24.85
    },
    {
      "text": "inte lika stora bitar",
      "start": 24.85,
      "end": 26.84
    },
    {
      "text": "Gör om allt till femtiondelar",
      "start": 26.84,
      "end": 29.31
    },
    {
      "text": "En femtedel är 10 femtiondelar",
      "start": 29.31,
      "end": 32.77
    },
    {
      "text": "3 tjugofemtedelar är 6 femtiondelar",
      "start": 32.88,
      "end": 36.58
    },
    {
      "text": "Nu kan täljarna läggas ihop",
      "start": 36.58,
      "end": 38.44
    },
    {
      "text": "Det blir 25 femtiondelar",
      "start": 38.44,
      "end": 40.861
    },
    {
      "text": "Och 25 är hälften av 50",
      "start": 40.861,
      "end": 43.491
    },
    {
      "text": "En halv",
      "start": 43.491,
      "end": 44.471
    },
    {
      "text": "Svaret är D",
