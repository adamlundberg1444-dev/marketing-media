  "writeLines": [
    {
      "text": "59 + 33 + 2x = 180"
    },
    {
      "text": "59 + 33 = 92"
    },
    {
      "text": "2x = 180 - 92 = 88"
    },
    {
      "text": "x = \\frac{88}{2} = 44°"
    },
    {
      "text": "v = 180 - 44 - 33"
    },
    {
      "text": "= 136 - 33 = 103°",
      "emphasis": true
    },
    {
      "text": "Fler HP-frågor i HPHome",
      "cta": true
    }
